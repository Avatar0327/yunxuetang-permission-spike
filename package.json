    "vue": "3.5.22"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "csv-parse": "7.0.2",
    "fastify": "5.12.1"
